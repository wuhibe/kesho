{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "([ \"$VERCEL_ENV\" != production ] || (pnpm check:key && prisma migrate deploy)) && next build",
  "crons": [
    { "path": "/api/cron/deliver", "schedule": "0 6 * * *" },
    { "path": "/api/cron/deliver", "schedule": "0 7 * * *" },
    { "path": "/api/cron/deliver", "schedule": "0 8 * * *" },
    { "path": "/api/cron/report", "schedule": "0 9 * * *" }
  ]
}
